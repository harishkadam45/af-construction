---
import { process } from '../data/site.js';
const { eyebrow = 'HOW IT COMES TOGETHER' } = Astro.props;
---
<section class="section process"><div class="section-heading reveal"><p class="eyebrow">{eyebrow}</p><h2>A clear path.<br/><em>From idea to reality.</em></h2></div><div class="process-grid">{process.map(([n,t,d]) => <article class="reveal"><span>{n}</span><h3>{t}</h3><p>{d}</p></article>)}</div></section>
