---
import Layout from '../layouts/Layout.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Process from '../components/Process.astro';
import CtaBand from '../components/CtaBand.astro';
import { yelp } from '../data/site.js';
---
<Layout>
<section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="dot"></span> LOS ANGELES GENERAL CONTRACTOR</p><h1>Good spaces.<br/>Great possibilities.<br/><em>Built together.</em></h1><p class="intro">From the first sketch to the finishing touch.<br/>Your Los Angeles partner for construction,<br class="desktop"/> renovation, and everything in between.</p><a href="/contact/" class="button">Let’s build something <span>↗</span></a><div class="hero-proof"><span class="stars">★★★★★</span><span>5.0 on Yelp <small>· 1 review</small></span><a href={yelp} target="_blank" rel="noopener noreferrer" aria-label="Read AF Construction on Yelp">↗</a></div></div><div class="hero-visual"><div class="visual-top"><span>THE ART OF BUILDING</span><span>34.0522° N / 118.2437° W</span></div><img class="hero-photo" src="/images/projects/modern-kitchen.jpg" alt="Modern kitchen with a marble waterfall island and custom cabinetry, designed and built by AF Construction in Los Angeles" width="640" height="476" fetchpriority="high"/><div class="visual-bottom"><span>Thoughtful design.<br/><strong>Solid foundations.</strong></span></div></div><div class="hero-bottom"><span>LOCAL EXPERTISE. LASTING CRAFTSMANSHIP.</span><a href="#services">SCROLL TO EXPLORE <span>↓</span></a></div></section>
<div class="ticker"><span>DESIGN</span><i>✳</i><span>BUILD</span><i>✳</i><span>RENOVATE</span><i>✳</i><span>MAKE IT YOURS</span><i>✳</i><span>AF CONSTRUCTION</span></div>
<section id="services" class="section services"><div class="section-heading reveal"><p class="eyebrow">01 / CONSTRUCTION SERVICES IN LOS ANGELES</p><h2>One team.<br/><em>So many possibilities.</em></h2><p>Big plans or the details that make a home work.<br/>We help bring your next chapter to life.</p></div><ServicesGrid/><a class="text-link section-more reveal" href="/services/">Explore all services <span>↗</span></a></section>
<section class="about section"><figure class="about-art reveal"><img src="/images/projects/alex-new-build.jpg" alt="Alex Nouri, owner of AF Construction, on site at a new ground-up home" width="470" height="790" loading="lazy"/><figcaption>ALEX NOURI ON SITE / AF CONSTRUCTION</figcaption></figure><div class="about-copy reveal"><p class="eyebrow">02 / THE PEOPLE BEHIND THE BUILD</p><h2>Your space.<br/>Our commitment.<br/><em>A shared vision.</em></h2><p>AF Construction is led by Alex Nouri and serves the Los Angeles area. We bring design, construction, and essential home services together, helping you move from an idea to a space that works for you.</p><a class="text-link" href="/about/">More about AF Construction <span>↗</span></a></div></section>
<section class="section work"><div class="section-heading reveal"><p class="eyebrow">03 / FROM THE JOB SITE</p><h2>Real projects.<br/><em>Built from the ground up.</em></h2><p>Framing, foundations, finishes and more,<br/>straight from Alex’s job sites across Los Angeles.</p></div><WorkGrid limit={8}/><a class="text-link section-more reveal" href="/projects/">See all projects <span>↗</span></a></section>
<Process eyebrow="04 / HOW IT COMES TOGETHER"/>
<CtaBand/>
</Layout>
