---
import Layout from '../layouts/Layout.astro';
import { services, phone, yelp } from '../data/site.js';
---
<Layout title="Contact AF Construction | Free Estimate in Los Angeles" description="Call AF Construction at (310) 424-8000 for a free construction estimate in Los Angeles. Open Monday-Friday 7 am-7 pm and Saturday 10 am-6 pm." breadcrumb="Contact us">
<section class="contact contact-page section"><div class="contact-copy"><p class="eyebrow">LET’S START SOMETHING</p><h1>Big idea?<br/>Small upgrade?<br/><em>We’re all ears.</em></h1><p>Tell Alex what you’re planning.<br/>Call for a free estimate and a conversation<br/>about what comes next.</p><a href={phone.href} class="phone">{phone.label} <span>↗</span></a><div class="hours"><p>LOS ANGELES, CA 90001</p><p>Monday-Friday <span>7 am-7 pm</span><br/>Saturday <span>10 am-6 pm</span><br/>Sunday <span>Closed</span></p></div></div><form id="estimate-form" class="estimate-form"><h2 class="form-title">Request a free estimate.</h2><p>Prepare your project details, then connect with Alex on Yelp.</p><label>Your name<input name="name" autocomplete="name" placeholder="Alex Smith" required maxlength="100"/></label><label>What can we help with?<select name="service" required><option value="">Select a service</option>{services.map(([,title])=><option>{title}</option>)}<option>Something else</option></select></label><label>A little about your project<textarea name="details" placeholder="Your ideas, location, and ideal timeline…" rows="3" required maxlength="2000"></textarea></label><button class="button" type="submit">Prepare inquiry <span>↗</span></button><p class="form-note">This form prepares a summary on your device. Send your request through Yelp or call us directly.</p><div id="inquiry-result" hidden role="status"><p>Your project summary is ready. Copy it, then paste it into your Yelp inquiry.</p><textarea id="summary" readonly aria-label="Project inquiry summary"></textarea><button type="button" id="copy-summary" class="text-link">Copy summary</button><a href={yelp} target="_blank" rel="noopener noreferrer" class="text-link">Continue on Yelp ↗</a></div></form></section>
</Layout>
